# Local development uses the existing Copilot CLI login when this is empty.
# Hosted deployment requires this value and injects it through the azd environment.
COPILOT_GITHUB_TOKEN=
DEFAULT_COPILOT_MODEL=gpt-5.6-sol
COPILOT_MAX_CONCURRENT_REQUESTS=4
COPILOT_RESPONSE_TIMEOUT_SECONDS=180
COPILOT_LOG_LEVEL=warning
